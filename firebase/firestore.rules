rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Byt ut mot kansliets adminadresser (samma som IFK.admins i data.js)
    function isAdmin() { return request.auth != null && request.auth.token.email in ['kansli@ifkskovdefk.se']; }
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsSuffix(id) { return signedIn() && id.matches('.*_' + request.auth.uid); }

    match /users/{uid}        { allow read: if signedIn(); allow write: if owner(uid) || isAdmin(); }
    match /lineups/{uid}      { allow read: if owner(uid) || isAdmin(); allow write: if owner(uid) || isAdmin(); }
    match /entries/{id}       { allow read: if isAdmin() || ownsSuffix(id); allow write: if ownsSuffix(id) || isAdmin(); }
    match /predictions/{id}   { allow read: if isAdmin() || ownsSuffix(id); allow write: if ownsSuffix(id); }
    match /motm/{id}          { allow read: if true; allow write: if ownsSuffix(id); }
    match /stats/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /scores/{id}        { allow read: if ownsSuffix(id) || isAdmin(); allow write: if isAdmin(); }
    match /standings/{uid}    { allow read: if true; allow write: if isAdmin() || (owner(uid) && !('gw' in request.resource.data.diff(resource.data).affectedKeys()) && !('tips' in request.resource.data.diff(resource.data).affectedKeys()) && !('rank' in request.resource.data.diff(resource.data).affectedKeys())); }
    match /leagues/{code}     { allow read: if true; allow create: if signedIn(); allow update: if signedIn(); allow delete: if isAdmin(); }
  }
}
